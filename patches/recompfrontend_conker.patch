+++ b/recompui/src/elements/ui_conker_look.h
@@ -0,0 +1,69 @@
+#ifndef RECOMPUI_CONKER_LOOK_H
+#define RECOMPUI_CONKER_LOOK_H
+
+#include "ui_element.h"
+
+// Conker's own menu look for the settings: pill rings (the chosen one filled orange with light letters, the
+// others a steel ring with soft cream letters), gold names, orange for the option you're on. Kept soft so
+// it's easy on the eyes. Outlines and shadows: conker-* classes in recomp.rcss.
+namespace recompui::conker_look {
+    constexpr const char *font = "Luckiest Guy";
+    constexpr Color gold{ 0xF0, 0xD4, 0x8A, 0xFF };       // option names
+    constexpr Color orange{ 0xFF, 0xB2, 0x5C, 0xFF };     // the option you're on
+    constexpr Color ring{ 0xF2, 0x8C, 0x3E, 0xFF };       // the chosen pill's ring
+    constexpr Color fill{ 0xC8, 0x56, 0x1A, 0xFF };       // the chosen pill, and the sliders
+    constexpr Color chosen_text{ 0xFF, 0xF4, 0xE2, 0xFF };
+    constexpr Color steel{ 0x6E, 0x74, 0x7C, 0xFF };      // the other pills' ring
+    constexpr Color brown{ 0xC8, 0xBC, 0xA8, 0xFF };      // the other pills' letters
+    constexpr Color brown_lit{ 0xEE, 0xE2, 0xCC, 0xFF };  // pointed at
+    constexpr Color red{ 0xD8, 0x2A, 0x14, 0xFF };
+    constexpr Color purple{ 0x6E, 0x3C, 0xB0, 0xFF };
+    constexpr Color track{ 0x26, 0x28, 0x2C, 0xFF };
+    constexpr Color knob{ 0xE6, 0xE8, 0xEC, 0xFF };
+    constexpr Color white{ 0xFF, 0xFF, 0xFF, 0xFF };
+    constexpr Color black{ 0x00, 0x00, 0x00, 0xFF };
+
+    // Letters in Conker's font (it has no bold face).
+    inline void letters(Style *style, float size) {
+        style->set_font_family(font);
+        style->set_font_weight(400);
+        style->set_font_size(size);
+        style->set_letter_spacing(0.0f);
+    }
+
+    // A pill ring around the letters, not chosen yet.
+    inline void pill(Element *element, float size) {
+        letters(element, size);
+        element->add_class("conker-pill");
+        element->set_white_space(WhiteSpace::Nowrap);
+        element->set_border_width(3.0f);
+        element->set_border_radius(size);
+        element->set_border_color(steel);
+        element->set_background_color(Color{ 0, 0, 0, 0 }); // (so a chosen pill's fill goes when it's no longer chosen)
+        element->set_color(brown);
+        element->set_padding_top(size * 0.22f);
+        element->set_padding_bottom(size * 0.08f);
+        element->set_padding_left(size * 0.6f);
+        element->set_padding_right(size * 0.6f);
+    }
+
+    // A button's look (Install Mods, Reset to Defaults, Apply, the X...): a steel ring with light letters, filled
+    // orange while pointed at or selected. The hover, focus and disabled styles are the button's own.
+    inline void button(Element *element, Style &hover, Style &focus, Style &disabled, Style &hover_disabled) {
+        element->set_border_color(steel);
+        element->set_background_color(Color{ 0, 0, 0, 0 });
+        element->set_color(brown_lit);
+        for (Style *style : { &hover, &focus }) {
+            style->set_border_color(ring);
+            style->set_background_color(fill);
+            style->set_color(chosen_text);
+        }
+        for (Style *style : { &disabled, &hover_disabled }) {
+            style->set_border_color(Color{ steel.r, steel.g, steel.b, 0x60 });
+            style->set_background_color(Color{ 0, 0, 0, 0 });
+            style->set_color(Color{ brown.r, brown.g, brown.b, 0x70 });
+        }
+    }
+}
+
+#endif
