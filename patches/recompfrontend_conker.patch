+void Modal::set_backdrop(const std::string &src) {
+    bool opened = modal_root_context.open_if_not_already();
+    Image *image = modal_root_context.create_element<Image>(backdrop, src);
+    image->set_width(100.0f, Unit::Percent);
+    image->set_height(100.0f, Unit::Percent);
+    has_backdrop = true;
+    modal_element->set_background_color(Color{ 0, 0, 0, 0 });
+    modal_element->set_border_width(0.0f);
+    if (opened) {
+        modal_root_context.close();
+    }
+}
+
 Modal::~Modal() {
 }
 
 void Modal::open() {
+    if (has_backdrop) {
+        // The picture only before the game starts: in the game, the game shows darkened behind.
+        bool show = !ultramodern::is_game_started();
+        backdrop->set_display(show ? Display::Block : Display::None);
+        modal_overlay->set_background_color(show ? Color{ 0, 0, 0, 255 } : Color{ 0x0B, 0x06, 0x04, 0xD0 });
+    }
     if (!recompui::is_context_shown(modal_root_context)) {
