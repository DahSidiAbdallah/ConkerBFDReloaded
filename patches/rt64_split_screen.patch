+    bool Workload::viewOfProjection(const Projection &proj, FixedRect &viewRect) const {
+        if ((proj.type != Projection::Type::Perspective) || proj.scissorRect.isNull()) {
+            return false;
+        }
+
+        const interop::RSPViewport &viewport = drawData.rspViewports[proj.transformsIndex];
+        const int16_t *viewportClipRatios = &drawData.viewportClipRatios[proj.transformsIndex * 4];
+        viewRect = proj.scissorRect.intersection(viewport.rect(viewportClipRatios));
+        return !viewRect.isEmpty() && (drawData.viewportOrigins[proj.transformsIndex] == G_EX_ORIGIN_NONE);
+    }
+
+    bool Workload::pairWidensView(const FramebufferPair &fbPair, const Projection &proj) const {
+        FixedRect viewRect;
+        if (!viewOfProjection(proj, viewRect)) {
+            return false;
+        }
+
+        const FixedRect wideningScissor = fbPair.wideningScissor();
+        const FixedRect &pairScissor = wideningScissor.isNull() ? proj.scissorRect : wideningScissor;
+        if (viewRect.width(true, true) <= viewRect.height(true, true)) {
+            return false;
+        }
+
+        if ((viewRect.ulx <= pairScissor.ulx + CoversWidthViewportSlack) && (viewRect.lrx >= pairScissor.lrx - CoversWidthViewportSlack)) {
+            return true;
+        }
+
+        // Conker: a split screen's row of views drawn in one pair (Beach's top two quarters in one, its bottom two in
+        // another): side by side they span the pair's width, and each is widened as if it had the pair to itself.
+        auto closeTo = [](int32_t a, int32_t b) { return std::abs(a - b) <= CoversWidthSlack; };
+        int32_t rowLeft = viewRect.ulx, rowRight = viewRect.lrx;
+        uint32_t rowViews = 0;
+        for (uint32_t p = 0; p < fbPair.projectionCount; p++) {
+            FixedRect otherRect;
+            if (!viewOfProjection(fbPair.projections[p], otherRect) || !closeTo(otherRect.uly, viewRect.uly) || !closeTo(otherRect.lry, viewRect.lry)) {
+                continue;
+            }
+
+            // Another view of the row, not one across it (its width is part of the row's).
+            if (!closeTo(otherRect.ulx, viewRect.ulx) || !closeTo(otherRect.lrx, viewRect.lrx)) {
+                rowViews++;
+            }
+
+            rowLeft = std::min(rowLeft, otherRect.ulx);
+            rowRight = std::max(rowRight, otherRect.lrx);
+        }
+
+        return (rowViews > 0) && (rowLeft <= pairScissor.ulx + CoversWidthViewportSlack) && (rowRight >= pairScissor.lrx - CoversWidthViewportSlack);
+    }
+
+    bool Workload::widensView(uint32_t colorAddress, const FixedRect &viewRect) const {
+        auto closeTo = [](int32_t a, int32_t b) { return std::abs(a - b) <= CoversWidthSlack; };
+        for (uint32_t q = 0; q < fbPairCount; q++) {
+            const FramebufferPair &viewPair = fbPairs[q];
+            if (viewPair.colorImage.address != colorAddress) {
+                continue;
+            }
+
+            for (uint32_t p = 0; p < viewPair.projectionCount; p++) {
+                const Projection &viewProj = viewPair.projections[p];
+                FixedRect otherRect;
+                if (!viewOfProjection(viewProj, otherRect)) {
+                    continue;
+                }
+
+                if (closeTo(otherRect.ulx, viewRect.ulx) && closeTo(otherRect.lrx, viewRect.lrx) && closeTo(otherRect.uly, viewRect.uly) && closeTo(otherRect.lry, viewRect.lry) &&
+                    pairWidensView(viewPair, viewProj))
+                {
+                    return true;
+                }
+            }
+        }
+
+        return false;
+    }
