+    FixedRect FramebufferPair::wideningScissor() const {
+        if (scissorRect.isNull()) {
+            return scissorRect;
+        }
+
+        // The pair's scissor without its projections of fill rects only.
+        FixedRect drawnScissor;
+        drawnScissor.reset();
+        bool fillsLeftOut = false;
+        for (uint32_t p = 0; p < projectionCount; p++) {
+            const Projection &proj = projections[p];
+            if (proj.scissorRect.isNull()) {
+                continue;
+            }
+
+            bool fillsOnly = (proj.type == Projection::Type::Rectangle) && (proj.gameCallCount > 0);
+            for (uint32_t c = 0; fillsOnly && (c < proj.gameCallCount); c++) {
+                fillsOnly = (proj.gameCalls[c].callDesc.otherMode.cycleType() == G_CYC_FILL);
+            }
+
+            if (fillsOnly) {
+                fillsLeftOut = true;
+            }
+            else {
+                drawnScissor.merge(proj.scissorRect);
+            }
+        }
+
+        if (!fillsLeftOut || drawnScissor.isNull()) {
+            return scissorRect;
+        }
+
+        const bool reachesLeft = (drawnScissor.ulx <= scissorRect.ulx + CoversWidthSlack);
+        const bool reachesRight = (drawnScissor.lrx >= scissorRect.lrx - CoversWidthSlack);
+        const bool wideEnough = (int64_t(drawnScissor.lrx - drawnScissor.ulx) * 10) >= (int64_t(scissorRect.lrx - scissorRect.ulx) * 4);
+        if ((reachesLeft != reachesRight) && wideEnough) {
+            return drawnScissor;
+        }
+
+        return scissorRect;
+    }
+
