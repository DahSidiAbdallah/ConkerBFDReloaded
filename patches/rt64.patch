+        memcpy(&vertices[dstIndex], dlVerts, sizeof(Vertex) * vtxCount);
+        if (cbfd.lighting) {
+            lightVerticesCBFD(dstIndex, vtxCount);
+        }
+
+        setVertexCommon<true, sizeof(Vertex)>(rdramAddress, dstIndex, dstIndex + vtxCount);
+    }
