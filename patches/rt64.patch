+        const float MinCutTurn = 50.0f * 3.14159265f / 180.0f;
+        const float CutJump = 4.0f;
+        const bool cut = ((move > MinCutMove) && (move > cameraMove * CutJump)) || ((turn > MinCutTurn) && (turn > cameraTurn * CutJump));
+        cameraMove = move;
+        cameraTurn = turn;
+        return cut;
+    }
