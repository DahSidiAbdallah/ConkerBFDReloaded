 static std::string fpr_to_string(int fpr_index) {
+    // Odd registers must go through f_odd for single-precision math too, the
+    // same storage lwc1/mtc1/mfc1/swc1 use (fpr_u32l_to_string). With FR=0 an
+    // odd register is the upper half of the even one below it; using ctx->fN
+    // here made hand-written code (Conker's renderer) compute with values it
+    // never loaded. With FR=1 f_odd points at fN.u32l, so this is identical.
+    if (fpr_index & 1) {
+        return fmt::format("(*(float*)&ctx->f_odd[({} - 1) * 2])", fpr_index);
+    }
     return fmt::format("ctx->f{}.fl", fpr_index);
 }
 
@@ -414,6 +422,14 @@ void N64Recomp::CGenerator::emit_function_call_by_register(int reg) const {
     fmt::print(output_file, "LOOKUP_FUNC({})(rdram, ctx);\n", gpr_to_string(reg));
 }
 
+void N64Recomp::CGenerator::emit_save_jump_register(int reg, uint32_t vram) const {
+    fmt::print(output_file, "gpr jr_target_{:08X} = {};\n", vram, gpr_to_string(reg));
+}
+
+void N64Recomp::CGenerator::emit_function_call_by_saved_register(uint32_t vram) const {
+    fmt::print(output_file, "LOOKUP_FUNC(jr_target_{:08X})(rdram, ctx);\n", vram);
+}
