diff --git a/src/shared/rt64_cbfd_pixel_light.h b/src/shared/rt64_cbfd_pixel_light.h
new file mode 100644
index 0000000..b5b9abb
--- /dev/null
+++ b/src/shared/rt64_cbfd_pixel_light.h
@@ -0,0 +1,62 @@
+//
+// RT64
+//
+
+#pragma once
+
+#include "shared/rt64_hlsl.h"
+
+// Conker: smooth shading. Conker's microcode (F3DEX2CBFD) lights each vertex from the game's
+// point lights; RT64 does that on the CPU (RSP::lightVerticesCBFD). With smooth shading, the
+// point lights are worked out for each pixel instead, from the position the vertices are lit
+// from (interpolated across the triangle), with the same formula: soft, round pools of light
+// instead of the vertices' blotches.
+#define CBFD_PIXEL_MAX_POINT_LIGHTS 10
+// Marks the vertices lit per pixel (in their base's w), so that rects and other draws that don't
+// carry the lighting data never are.
+#define CBFD_PIXEL_LIGHT_MARK 12345.0f
+
+#ifdef HLSL_CPU
+namespace interop {
+#endif
+    struct CBFDPixelLight {
+        float4 posCa;  // position in the lighting space (xyz) and strength (w)
+        float4 col;    // colour (rgb)
+        float4 dir;    // direction in model space (xyz), and 1 in w when the normal's term applies
+    };
+
+    struct CBFDPixelLightSet {
+        uint count;
+        uint pad0;
+        uint pad1;
+        uint pad2;
+        CBFDPixelLight lights[CBFD_PIXEL_MAX_POINT_LIGHTS];
+    };
+
+#ifndef HLSL_CPU
+    // The lighting factor at a pixel: its base (ambient and directional light, interpolated) and
+    // each point light, capped at 1, as RSP::lightVerticesCBFD does for a vertex.
+    float3 cbfdPixelLightFactor(const CBFDPixelLightSet lightSet, float3 pos, float3 normal, float3 base) {
+        float3 factor = base;
+        const float normalLength = length(normal);
+        const float3 unitNormal = (normalLength > 0.0f) ? (normal / normalLength) : normal;
+        for (uint l = 0; l < min(lightSet.count, (uint)(CBFD_PIXEL_MAX_POINT_LIGHTS)); l++) {
+            const CBFDPixelLight light = lightSet.lights[l];
+            const float3 v = pos - light.posCa.xyz;
+            const float len = 2.0f * dot(v, v) / 65536.0f;
+            float intensity = (len > 0.0f) ? min(1.0f, light.posCa.w / len) : 1.0f;
+            if (light.dir.w > 0.5f) {
+                intensity *= min(1.0f, dot(unitNormal, light.dir.xyz));
+            }
+
+            if (intensity > 0.0f) {
+                factor += light.col.rgb * intensity;
+            }
+        }
+
+        return min(factor, 1.0f);
+    }
+#endif
+#ifdef HLSL_CPU
+};
+#endif
