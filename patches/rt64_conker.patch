diff --git a/src/hle/rt64_rect_neighbours.h b/src/hle/rt64_rect_neighbours.h
new file mode 100644
index 0000000..599e685
--- /dev/null
+++ b/src/hle/rt64_rect_neighbours.h
@@ -0,0 +1,92 @@
+//
+// Conker: pictures drawn as pieces side by side (the menus' buttons and titles are 32x32 pieces).
+// Filtering stops at each piece's clamped edge, which shows as a thin line through the picture
+// when drawn above the N64's resolution; each piece gets the texture of the piece drawn right
+// against its right and bottom edges (GPUTile.neighbourRight/Down, used by TextureSampler.hlsli)
+// so filtering blends across the join, as if the picture were one texture.
+//
+
+#pragma once
+
+#include <cmath>
+#include <cstring>
+#include <vector>
+
+#include "hle/rt64_workload.h"
+
+namespace RT64 {
+    inline void linkRectNeighbours(Workload &workload, uint32_t tileBegin, uint32_t tileEnd) {
+        struct Piece {
+            int32_t ulx, uly, lrx, lry;
+            uint32_t tile, order;
+            const DrawCall *call;
+        };
+
+        // Pieces of one picture are drawn with the same settings (colours, combiner, blending).
+        auto sameLook = [](const DrawCall &a, const DrawCall &b) {
+            return (memcmp(&a.colorCombiner, &b.colorCombiner, sizeof(a.colorCombiner)) == 0) && (memcmp(&a.otherMode, &b.otherMode, sizeof(a.otherMode)) == 0) &&
+                (memcmp(&a.rdpParams, &b.rdpParams, sizeof(a.rdpParams)) == 0);
+        };
+
+        auto &drawData = workload.drawData;
+        std::vector<Piece> pieces;
+        for (uint32_t f = 0; f < workload.fbPairCount; f++) {
+            const FramebufferPair &fbPair = workload.fbPairs[f];
+            for (uint32_t p = 0; p < fbPair.projectionCount; p++) {
+                const Projection &proj = fbPair.projections[p];
+                if (proj.type != Projection::Type::Rectangle) {
+                    continue;
+                }
+
+                // The pieces: drawn at their own size, from a texture (not a copy of the screen).
+                pieces.clear();
+                for (uint32_t d = 0; d < proj.gameCallCount; d++) {
+                    const DrawCall &call = proj.gameCalls[d].callDesc;
+                    if ((call.tileCount == 0) || (call.tileIndex < tileBegin) || (call.tileIndex >= tileEnd) || (call.rectDsdx <= 0) || (call.rectDtdy <= 0) || !call.identityRectScale()) {
+                        continue;
+                    }
+
+                    const uint32_t t = call.tileIndex;
+                    const interop::RDPTile &rdpTile = drawData.rdpTiles[t];
+                    const interop::GPUTile &gpuTile = drawData.gpuTiles[t];
+                    if (gpuTile.flags.fromCopy || gpuTile.flags.rawTMEM) {
+                        continue;
+                    }
+
+                    const int32_t width = int32_t(std::lround((rdpTile.lrs - rdpTile.uls) / 4.0f)) + 1;
+                    const int32_t height = int32_t(std::lround((rdpTile.lrt - rdpTile.ult) / 4.0f)) + 1;
+                    if (((call.rect.lrx - call.rect.ulx) != width * 4) || ((call.rect.lry - call.rect.uly) != height * 4)) {
+                        continue;
+                    }
+
+                    pieces.push_back({ call.rect.ulx, call.rect.uly, call.rect.lrx, call.rect.lry, t, d, &call });
+                }
+
+                // A button's normal and glowing pieces can both be drawn at the same place: the
+                // neighbour is one drawn the same way, and closest in order (a picture's pieces are
+                // drawn together).
+                for (const Piece &a : pieces) {
+                    interop::GPUTile &gpuTile = drawData.gpuTiles[a.tile];
+                    uint32_t bestRight = UINT32_MAX, bestDown = UINT32_MAX;
+                    for (const Piece &b : pieces) {
+                        const interop::GPUTile &other = drawData.gpuTiles[b.tile];
+                        if ((&a == &b) || (other.tcScale.x != gpuTile.tcScale.x) || (other.tcScale.y != gpuTile.tcScale.y)) {
+                            continue;
+                        }
+
+                        const uint32_t distance = ((a.order > b.order) ? (a.order - b.order) : (b.order - a.order)) + (sameLook(*a.call, *b.call) ? 0U : 0x10000000U);
+                        if ((b.ulx == a.lrx) && (b.uly == a.uly) && (b.lry == a.lry) && (distance < bestRight)) {
+                            bestRight = distance;
+                            gpuTile.neighbourRight = other.textureIndex;
+                        }
+
+                        if ((b.uly == a.lry) && (b.ulx == a.ulx) && (b.lrx == a.lrx) && (distance < bestDown)) {
+                            bestDown = distance;
+                            gpuTile.neighbourDown = other.textureIndex;
+                        }
+                    }
+                }
+            }
+        }
+    }
+};
