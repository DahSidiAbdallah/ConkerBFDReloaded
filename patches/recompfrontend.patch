diff --git a/recompinput/src/input_events.cpp b/recompinput/src/input_events.cpp
index c76a1dc..e17c26f 100644
--- a/recompinput/src/input_events.cpp
+++ b/recompinput/src/input_events.cpp
@@ -238,6 +238,21 @@ bool sdl_event_filter(void* userdata, SDL_Event* event) {
         // Always queue button up events to avoid missing them during binding.
         recompui::queue_event(*event);
         break;
+    case SDL_EventType::SDL_MOUSEBUTTONDOWN:
+        // Mouse buttons are bound with the keyboard, or in single player with the controller too
+        // (both profiles are read then; in multiplayer a controller is one player's). The click
+        // that starts binding has already gone by when scanning begins, so the next press is the
+        // one bound.
+        if (binding::is_binding()) {
+            const InputDevice device = binding::get_scanning_device();
+            if (device == InputDevice::Keyboard || (device == InputDevice::Controller && players::is_single_player_mode())) {
+                binding::set_scanned_input({ InputType::Mouse, event->button.button });
+            }
+        }
+        else {
+            queue_if_enabled(event);
+        }
+        break;
     default:
         queue_if_enabled(event);
         break;
