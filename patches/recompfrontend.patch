+static std::string mouse_button_to_string(int button) {
+    switch (button) {
+    case SDL_BUTTON_LEFT:
+        return PF_MOUSE_LEFT;
+    case SDL_BUTTON_MIDDLE:
+        return PF_MOUSE_MIDDLE;
+    case SDL_BUTTON_RIGHT:
+        return PF_MOUSE_RIGHT;
+    case SDL_BUTTON_X1:
+        return PF_MOUSE_4;
+    case SDL_BUTTON_X2:
+        return PF_MOUSE_5;
+    case 6:
+        return PF_MOUSE_6;
+    case 7:
+        return PF_MOUSE_7;
+    case 8:
+        return PF_MOUSE_8;
+    default:
+        return recompinput::unknown_device_input;
+    }
+}
