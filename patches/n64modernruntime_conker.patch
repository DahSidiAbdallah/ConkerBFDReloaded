+constexpr uint32_t counter_per_ms = 46'875;
 
 struct OSTimer {
     PTR(OSTimer) unused1;
@@ -59,11 +65,11 @@ std::chrono::microseconds ticks_to_duration(uint64_t ticks) {
 }
 
 std::chrono::high_resolution_clock::time_point ticks_to_timepoint(uint64_t ticks) {
-    return start_time + ticks_to_duration(ticks);
+    return ultramodern::game_time_to_wall(ticks_to_duration(ticks));
 }
 
