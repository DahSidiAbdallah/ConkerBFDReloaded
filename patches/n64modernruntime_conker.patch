--- a/ultramodern/src/timer.cpp
+++ b/ultramodern/src/timer.cpp
@@ -1,3 +1,4 @@
+#include <mutex>
 #include <thread>
 #include <variant>
 #include <set>
@@ -16,9 +17,14 @@ static std::chrono::high_resolution_clock::time_point start_time = std::chrono::
 // Offset of the duration since program start used to calculate the value for osGetTime. 
 static int64_t ostime_offset = 0;
 // Game speed multiplier (1 means no speedup)
-constexpr uint32_t speed_multiplier = 1;
+static uint32_t speed_multiplier = 1;
+// The game's clock runs speed_multiplier times as fast as real time. It stays continuous
+// when the multiplier changes: game time = base_game + (now - base_wall) * multiplier.
+static std::mutex game_clock_mutex;
+static std::chrono::high_resolution_clock::time_point base_wall = start_time;
+static std::chrono::high_resolution_clock::duration base_game{0};
 // N64 CPU counter ticks per millisecond
