@@ -581,6 +581,16 @@ bool Config::is_dirty() const {
 
 void Config::add_option_change_callback(const std::string& option_id, on_option_change_callback callback) {
     size_t option_index = schema.options_by_id[option_id];
+    // Conker: a second callback for an option runs after the first instead of replacing it.
+    auto existing = option_change_callbacks.find(option_index);
+    if (existing != option_change_callbacks.end() && existing->second) {
+        on_option_change_callback first = existing->second;
+        existing->second = [first, callback](ConfigValueVariant cur_value, ConfigValueVariant prev_value, OptionChangeContext change_context) {
+            first(cur_value, prev_value, change_context);
+            callback(cur_value, prev_value, change_context);
+        };
+        return;
+    }
     option_change_callbacks[option_index] = callback;
 }
 
