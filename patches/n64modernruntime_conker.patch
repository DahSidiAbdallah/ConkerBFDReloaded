-    return duration_to_ticks(std::chrono::high_resolution_clock::now() - start_time);
+    return duration_to_ticks(ultramodern::game_time_since_start());
 }
 
 void timer_thread(RDRAM_ARG1) {
@@ -149,6 +155,24 @@ uint32_t ultramodern::get_speed_multiplier() {
     return speed_multiplier;
 }
 
+void ultramodern::set_speed_multiplier(uint32_t multiplier) {
+    std::lock_guard lock{ game_clock_mutex };
+    auto now = std::chrono::high_resolution_clock::now();
+    base_game += (now - base_wall) * speed_multiplier;
+    base_wall = now;
+    speed_multiplier = multiplier > 0 ? multiplier : 1;
+}
+
+std::chrono::high_resolution_clock::duration ultramodern::game_time_since_start() {
+    std::lock_guard lock{ game_clock_mutex };
+    return base_game + (std::chrono::high_resolution_clock::now() - base_wall) * speed_multiplier;
+}
+
+std::chrono::high_resolution_clock::time_point ultramodern::game_time_to_wall(std::chrono::high_resolution_clock::duration game_time) {
+    std::lock_guard lock{ game_clock_mutex };
+    return base_wall + (game_time - base_game) / speed_multiplier;
+}
+
 std::chrono::high_resolution_clock::time_point ultramodern::get_start() {
     return start_time;
 }
