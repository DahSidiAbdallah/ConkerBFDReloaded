// The exe's icon and details (Explorer's Properties). Generated by CMake from icon/conker.rc.in.
#include <winver.h>

1 ICON "@CMAKE_CURRENT_SOURCE_DIR@/icon/conker.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @CONKER_VERSION_MAJOR@,@CONKER_VERSION_MINOR@,@CONKER_VERSION_PATCH@,0
PRODUCTVERSION @CONKER_VERSION_MAJOR@,@CONKER_VERSION_MINOR@,@CONKER_VERSION_PATCH@,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "dahmedvall95"
            VALUE "FileDescription", "Conker's Bad Fur Day: Reloaded"
            VALUE "FileVersion", "@CONKER_VERSION_STRING@"
            VALUE "InternalName", "ConkerBFDReloaded"
            VALUE "LegalCopyright", "(c) 2026 dahmedvall95. MIT License. Conker's Bad Fur Day is (c) Rare / Microsoft."
            VALUE "OriginalFilename", "ConkerBFDReloaded.exe"
            VALUE "ProductName", "Conker's Bad Fur Day: Reloaded"
            VALUE "ProductVersion", "@CONKER_VERSION_STRING@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
